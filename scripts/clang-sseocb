#!/usr/bin/env bash
set -euo pipefail

usage() {
    echo "Usage: $0 <mode> [clang-args...]" >&2
    echo "Modes:" >&2
    echo "  guest         Compile guest C/assembly code to object with globalization" >&2
    echo "  native        Compile native C/assembly code to object" >&2
    echo "  guest-merge   Merge multiple guest object files into a single relocatable .o" >&2
    echo "  native-merge  Merge multiple native object files into a single relocatable .o" >&2
    exit 1
}

if [[ $# -lt 1 ]]; then
    usage
fi

MODE="$1"
shift

CLANG="${CLANG:-$(command -v clang || true)}"
if [[ -z "$CLANG" ]]; then
    echo "Error: 'clang' not found in PATH" >&2
    exit 1
fi

NO_NATIVE_C=0
if [[ "${SSEOCB_NATIVE_NO_C:-0}" == "1" ]]; then
    NO_NATIVE_C=1
fi

FILTERED_ARGS=()
for arg in "$@"; do
    if [[ "$arg" == "--no-native-c" ]]; then
        NO_NATIVE_C=1
    else
        FILTERED_ARGS+=("$arg")
    fi
done
set -- "${FILTERED_ARGS[@]}"

COMMON_FLAGS=(
    --target=riscv32
    -mabi=ilp32e
    -mno-relax
    -ffreestanding
    -nostdlib
)

case "$MODE" in
    guest)
        BASE_FLAGS=(
            "${COMMON_FLAGS[@]}"
            -march=rv32ec
            -fno-optimize-sibling-calls
            -ffunction-sections
            -fno-addrsig
            -Oz
        )

        HAS_COMPILE_OR_SPECIAL=0
        for arg in "$@"; do
            case "$arg" in
                -c|-S|-E|-M|-MM|--version|-v|-###)
                    HAS_COMPILE_OR_SPECIAL=1
                    break
                    ;;
            esac
        done

        if [[ $HAS_COMPILE_OR_SPECIAL -eq 0 ]]; then
            BASE_FLAGS+=(-c)
        fi

        "$CLANG" "${BASE_FLAGS[@]}" "$@"

        OUT_OBJ=""
        for ((i = 1; i <= $#; i++)); do
            arg="${!i}"
            if [[ "$arg" == "-o" ]]; then
                next=$((i + 1))
                OUT_OBJ="${!next:-}"
                break
            elif [[ -z "$OUT_OBJ" && "$arg" =~ \.(c|s|S)$ ]]; then
                OUT_OBJ="$(basename "${arg%.*}").o"
            fi
        done

        if [[ -n "$OUT_OBJ" && -f "$OUT_OBJ" ]]; then
            REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
            for candidate in "$REPO_ROOT/target/release/tool" "$REPO_ROOT/target/debug/tool" "$(command -v tool || true)"; do
                if [[ -n "$candidate" && -x "$candidate" ]]; then
                    exec "$candidate" globalize "$OUT_OBJ"
                fi
            done
            echo "Error: 'tool' binary not found to globalize $OUT_OBJ" >&2
            exit 1
        fi
        ;;

    native)
        NATIVE_ARCH="rv32ec"
        if [[ $NO_NATIVE_C -eq 1 ]]; then
            NATIVE_ARCH="rv32e"
        fi

        BASE_FLAGS=(
            "${COMMON_FLAGS[@]}"
            -march="$NATIVE_ARCH"
            -fno-optimize-sibling-calls
            -Oz
        )

        HAS_COMPILE_OR_SPECIAL=0
        for arg in "$@"; do
            case "$arg" in
                -c|-S|-E|-M|-MM|--version|-v|-###)
                    HAS_COMPILE_OR_SPECIAL=1
                    break
                    ;;
            esac
        done

        if [[ $HAS_COMPILE_OR_SPECIAL -eq 0 ]]; then
            BASE_FLAGS+=(-c)
        fi

        exec "$CLANG" "${BASE_FLAGS[@]}" "$@"
        ;;

    guest-merge)
        BASE_FLAGS=(
            "${COMMON_FLAGS[@]}"
            -march=rv32ec
            -r
            -fuse-ld=lld
        )
        exec "$CLANG" "${BASE_FLAGS[@]}" "$@"
        ;;

    native-merge)
        NATIVE_ARCH="rv32ec"
        if [[ $NO_NATIVE_C -eq 1 ]]; then
            NATIVE_ARCH="rv32e"
        fi

        BASE_FLAGS=(
            "${COMMON_FLAGS[@]}"
            -march="$NATIVE_ARCH"
            -r
            -fuse-ld=lld
        )
        exec "$CLANG" "${BASE_FLAGS[@]}" "$@"
        ;;

    *)
        echo "Error: Unknown mode '$MODE'" >&2
        usage
        ;;
esac
